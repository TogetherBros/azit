<?xml version="1.0" encoding="utf-8"?>
<MsixPackagingToolTemplate
    xmlns="http://schemas.microsoft.com/msix/packaging/msixpackagingtool/template/2022">
    <Settings
        AllowTelemetry="false"
        ApplyACLsToPackageFiles="true"
        GenerateCommandLineFile="true"
        AllowPromptForPassword="false">
    </Settings>
    <Installer
        Path="azit.exe"
        Arguments=""
        InstallLocation="C:\Program Files\TogetherBros\아지트">
    </Installer>
    <PackageInformation
        PackageName="아지트"
        PackageDisplayName="아지트"
        PublisherName="CN=TogetherBros"
        PublisherDisplayName="TogetherBros"
        Version="0.1.0.0"
        PackageDescription="친구들끼리만 쓰는 메신저">
        <Capabilities>
            <Capability Name="runFullTrust" />
            
        </Capabilities>
        <Applications>
            <Application
                Id="com.togetherbros.azit"
                Description="친구들끼리만 쓰는 메신저"
                DisplayName="아지트"
                ExecutableName="azit.exe"
                EntryPoint="Windows.FullTrustApplication">
                
            </Application>
        </Applications>
        <Resources>
            <Resource Language="en-us" />
        </Resources>
        <Dependencies>
            <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.19041.0" />
        </Dependencies>
        <Properties>
            <Framework>false</Framework>
            <DisplayName>아지트</DisplayName>
            <PublisherDisplayName>TogetherBros</PublisherDisplayName>
            <Description>친구들끼리만 쓰는 메신저</Description>
            <Logo>Assets\AppIcon.png</Logo>
        </Properties>
    </PackageInformation>
    <SaveLocation PackagePath="azit.msix" />
    <PackageIntegrity>
        <CertificatePath></CertificatePath>
    </PackageIntegrity>
</MsixPackagingToolTemplate>

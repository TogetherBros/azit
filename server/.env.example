# 이 파일을 .env 로 복사해서 값을 채운다:  cp .env.example .env
# .env 는 git 에 올라가지 않는다.

# AT(JWT) 서명 키. 만들기: openssl rand -base64 32
JWT_SECRET=

# 1 이면 개발용 /dev/token 이 켜진다. 운영에서는 비워 둔다.
DEV=1

# 선택 (기본값 있음)
# PORT=8081
# DB_DSN=azit.db

# 구글 로그인 (Google Cloud 콘솔 → 클라이언트 → 데스크톱 앱)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
